# ── Database ─────────────────────────────────────────────────────────────
# When running via docker-compose, DATABASE_URL is set automatically to point
# at the postgres service. For `npm run dev` outside Docker, set it yourself:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svaramind_local

PORT=3002

# Extra origins allowed to call this API besides the built-in localhost:57424
# and localhost:5173 defaults (comma-separated). Add this if you changed
# FRONTEND_PORT in frontend/.env.
CORS_ORIGIN=

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Field-level encryption at rest (optional but recommended) ────────────
# Generate with: openssl rand -base64 32
NOTES_ENCRYPTION_KEY=

# ── MCP OAuth server (for Claude.ai / ChatGPT connector access) ──────────
# Generate with: openssl rand -base64 64
MCP_OAUTH_JWT_SECRET=
MCP_OAUTH_ISSUER=http://localhost:3002
# Shared secret for trusted internal service-to-service MCP calls (optional)
SVARAMIND_INTERNAL_KEY=

# ── LLM providers (all optional - only needed if you want that provider
# available as an admin/global fallback; users can also set their own keys
# per-provider in Settings > AI & LLM) ────────────────────────────────────
OPENROUTER_API_KEY=

# ── Web search (optional, only needed for the AI chat web-search feature) ─
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
