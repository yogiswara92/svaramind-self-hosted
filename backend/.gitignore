# Dependencies
node_modules/

# Vendored packages - exclude node_modules but keep dist
packages/*/node_modules/
packages/*/package-lock.json

# Environment
.env
.env.*
*.env
.env.local
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
/dist/
/build/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# OS
.DS_Store
Thumbs.db

# Uploads / temp files (user-uploaded content - never commit real files, just keep the folders)
uploads/
tmp/
temp/
storage/notes-images/*
storage/avatars/*
storage/documents/*
!storage/notes-images/.gitkeep
!storage/avatars/.gitkeep
!storage/documents/.gitkeep
